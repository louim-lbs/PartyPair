<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <uses-permission android:name="android.permission.BLUETOOTH_CONNECT" />
    <!-- Recherche des enceintes non appairées. Aucune donnée de position n'est utilisée. -->
    <uses-permission
        android:name="android.permission.BLUETOOTH_SCAN"
        android:usesPermissionFlags="neverForLocation"
        tools:targetApi="s" />
    <uses-permission
        android:name="android.permission.ACCESS_FINE_LOCATION"
        android:maxSdkVersion="30" />
    <uses-permission
        android:name="android.permission.BLUETOOTH"
        android:maxSdkVersion="30" />
    <uses-permission
        android:name="android.permission.BLUETOOTH_ADMIN"
        android:maxSdkVersion="30" />
    <!-- Declenchement avant l'alarme du telephone. -->
    <uses-permission android:name="android.permission.SCHEDULE_EXACT_ALARM" />
    <uses-permission android:name="android.permission.RECEIVE_BOOT_COMPLETED" />
    <!-- Controle des nouvelles versions publiees sur le depot. -->
    <uses-permission android:name="android.permission.INTERNET" />
    <!-- Installation de la mise a jour, apres confirmation de l'utilisateur. -->
    <uses-permission android:name="android.permission.REQUEST_INSTALL_PACKAGES" />
    <!--
        Depuis Android 13, aucune notification ne s'affiche sans cette
        autorisation : ni celle du service, ni l'alerte en cas d'echec.
    -->
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
    <!-- Invitation a lancer la musique au reveil, quand l'ecran est verrouille. -->
    <uses-permission android:name="android.permission.USE_FULL_SCREEN_INTENT" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_CONNECTED_DEVICE" />

    <uses-feature
        android:name="android.hardware.bluetooth_le"
        android:required="true" />

    <!-- Necessaire depuis Android 11 pour lister les applications musicales. -->
    <queries>
        <intent>
            <action android:name="android.intent.action.MAIN" />
            <category android:name="android.intent.category.APP_MUSIC" />
        </intent>
    </queries>

    <application
        android:allowBackup="true"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:fullBackupContent="@xml/backup_rules"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:roundIcon="@mipmap/ic_launcher"
        android:supportsRtl="true"
        android:localeConfig="@xml/locales_config"
        android:theme="@style/Theme.BoiteDeFete">

        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:theme="@style/Theme.BoiteDeFete">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <!-- Point d'entree sans interface, pour Tasker, Home Assistant ou adb. -->
        <activity
            android:name=".TriggerActivity"
            android:exported="true"
            android:excludeFromRecents="true"
            android:noHistory="true"
            android:taskAffinity=""
            android:theme="@android:style/Theme.NoDisplay">
            <intent-filter>
                <action android:name="fr.boitedefete.action.START" />
                <action android:name="fr.boitedefete.action.UNLINK" />
                <action android:name="fr.boitedefete.action.POWER_OFF" />
                <action android:name="fr.boitedefete.action.TOGGLE" />
                <action android:name="fr.boitedefete.action.PLAY_MUSIC" />
                <category android:name="android.intent.category.DEFAULT" />
            </intent-filter>
        </activity>

        <!--
            Raccourcis visibles dans le lanceur.

            Les routines Samsung ne savent déclencher que l'ouverture d'une
            application : ces deux entrées apparaissent donc dans leur liste et
            permettent de lancer l'appairage ou la mise en veille sans passer par
            l'interface.
        -->
        <activity-alias
            android:name=".StartShortcut"
            android:targetActivity=".TriggerActivity"
            android:exported="true"
            android:excludeFromRecents="true"
            android:icon="@mipmap/ic_launcher"
            android:label="@string/shortcut_start"
            android:theme="@android:style/Theme.NoDisplay">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity-alias>

        <activity-alias
            android:name=".StandbyShortcut"
            android:targetActivity=".TriggerActivity"
            android:exported="true"
            android:excludeFromRecents="true"
            android:icon="@mipmap/ic_launcher"
            android:label="@string/shortcut_standby"
            android:theme="@android:style/Theme.NoDisplay">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity-alias>

        <!--
            Reprogramme le declenchement quand l'alarme du telephone change ou
            apres un redemarrage, et recoit l'echeance elle-meme.
        -->
        <receiver
            android:name=".AlarmReceiver"
            android:exported="false">
            <intent-filter>
                <action android:name="fr.boitedefete.action.STOP_NOW" />
                <action android:name="android.app.action.NEXT_ALARM_CLOCK_CHANGED" />
                <action android:name="android.intent.action.BOOT_COMPLETED" />
                <action android:name="android.intent.action.MY_PACKAGE_REPLACED" />
            </intent-filter>
        </receiver>

        <!--
            Commandes par diffusion, pour Home Assistant et les automatisations.
            Contrairement au lancement d'activite, cette voie ne reclame aucune
            autorisation et n'interrompt pas ce qui est a l'ecran.
        -->
        <receiver
            android:name=".CommandReceiver"
            android:exported="true">
            <intent-filter>
                <action android:name="fr.boitedefete.action.START" />
                <action android:name="fr.boitedefete.action.TOGGLE" />
                <action android:name="fr.boitedefete.action.POWER_OFF" />
                <action android:name="fr.boitedefete.action.UNLINK" />
            </intent-filter>
        </receiver>

        <!-- Bouton d'ecran d'accueil. -->
        <receiver
            android:name=".PartyWidget"
            android:exported="false">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_UPDATE" />
            </intent-filter>
            <meta-data
                android:name="android.appwidget.provider"
                android:resource="@xml/party_widget_info" />
        </receiver>

        <!-- Raccourci dans le volet des reglages rapides. -->
        <service
            android:name=".PartyTileService"
            android:exported="true"
            android:icon="@drawable/ic_driver"
            android:label="@string/app_name"
            android:permission="android.permission.BIND_QUICK_SETTINGS_TILE">
            <intent-filter>
                <action android:name="android.service.quicksettings.action.QS_TILE" />
            </intent-filter>
        </service>

        <!-- Partage du fichier telecharge avec l'installateur du systeme. -->
        <provider
            android:name="androidx.core.content.FileProvider"
            android:authorities="${applicationId}.updates"
            android:exported="false"
            android:grantUriPermissions="true">
            <meta-data
                android:name="android.support.FILE_PROVIDER_PATHS"
                android:resource="@xml/file_paths" />
        </provider>

        <!--
            Sert uniquement a savoir quelle application detient la session media,
            afin de ne pas relancer un autre lecteur a la place de celui choisi.
            Aucune notification n'est lue.
        -->
        <service
            android:name=".NotificationListener"
            android:exported="false"
            android:permission="android.permission.BIND_NOTIFICATION_LISTENER_SERVICE">
            <intent-filter>
                <action android:name="android.service.notification.NotificationListenerService" />
            </intent-filter>
        </service>

        <service
            android:name=".PartyService"
            android:exported="false"
            android:foregroundServiceType="connectedDevice" />
    </application>
</manifest>
